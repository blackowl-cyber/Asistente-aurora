# Copia este archivo como .env y llena los valores.

# --- Servidor (bot de Telegram + orquestador) ---
ANTHROPIC_API_KEY=sk-ant-...
AURORA_TELEGRAM_TOKEN=123456:ABC...          # lo da @BotFather
AURORA_TELEGRAM_USUARIOS=123456789           # tu id de Telegram (usa /miid); varios separados por coma
AURORA_MODELO=claude-opus-5-5
AURORA_ESFUERZO=medium                       # low, medium, high
AURORA_PUERTO=8765

# --- Compartido entre servidor y agente ---
AURORA_TOKEN_AGENTE=cambia-esto-por-un-texto-largo-y-aleatorio

# --- Agente de PC ---
AURORA_SERVIDOR_URL=ws://127.0.0.1:8765/ws/agente
AURORA_DISPOSITIVO=PC
AURORA_CARPETA_TRABAJO=~/Documents/Aurora
